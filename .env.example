# ==========================================
# Django Environment Configuration Template
# Copy this file to .env and fill in your actual values
# ==========================================

# Django Core Settings
SECRET_KEY=replace-with-a-secure-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web,0.0.0.0

# PostgreSQL Database Configuration
POSTGRES_DB=your_database_name
POSTGRES_USER=your_database_user
POSTGRES_PASSWORD=your_database_password
DB_HOST=127.0.0.1
DB_PORT=5432

# MIDAS Hospital Management System Integration
# Toggle from 'stub' (in-memory test registry) to 'http' (live hospital servers)
MIDAS_BACKEND=stub
MIDAS_BASE_URL=https://hms.hamshospital.com/api/v1/
MIDAS_API_KEY=your-production-secret-token
MIDAS_TIMEOUT=5
MIDAS_MAX_RETRIES=2
